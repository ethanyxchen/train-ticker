{
  "name": "daily-schedule-cleanup-worker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cleanup:daily-schedule": "node dist/retain-latest-schedules.js",
